{
  "name": "@vd-creator/web",
  "version": "0.0.0",
  "private": true,
  "description": "Review UI. Talks to the server only and imports types from scenario.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vd-creator/scenario": "*"
  }
}
