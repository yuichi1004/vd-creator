{
  "name": "@vd-creator/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The vd command: init, validate, generate, render, serve.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vd": "./bin/vd.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vd-creator/core": "*",
    "@vd-creator/providers": "*",
    "@vd-creator/render": "*",
    "@vd-creator/scenario": "*",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
